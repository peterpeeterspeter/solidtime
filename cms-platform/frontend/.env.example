# Supabase Configuration
# Get these values from your Supabase project settings
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Functions URL
# Usually: https://your-project-id.supabase.co/functions/v1
VITE_SUPABASE_FUNCTION_URL=https://your-project-id.supabase.co/functions/v1

# Internal Function Token
# Generate a strong random token (min 32 characters)
# This must match the INTERNAL_FUNCTION_TOKEN secret in Supabase
# Example: openssl rand -hex 32
VITE_INTERNAL_FUNCTION_TOKEN=your-secure-random-token-here

# Optional: Enable debug logging in development
VITE_DEBUG=false
