# Application
APP_NAME=Timeclocker
APP_ENV=local
APP_KEY=base64:UNQNf1SXeASNkWux01Rj8EnHYx8FO0kAxWNDwktclkk=
APP_DEBUG=true
APP_URL=https://timeclocker.app
APP_FORCE_HTTPS=true
APP_ENABLE_REGISTRATION=true
SUPER_ADMINS=admin@timeclocker.app
PAGINATION_PER_PAGE_DEFAULT=500

# Logging
LOG_CHANNEL=single
LOG_DEPRECATIONS_CHANNEL=deprecation
LOG_LEVEL=debug

# Database
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=root

DB_TEST_HOST=pgsql_test
DB_TEST_PORT=5432
DB_TEST_DATABASE=laravel
DB_TEST_USERNAME=root
DB_TEST_PASSWORD=root

# Broadcasting
BROADCAST_DRIVER=null

# Cache
CACHE_DRIVER=file

# Queue
QUEUE_CONNECTION=sync

# Session
SESSION_DRIVER=database
SESSION_LIFETIME=120

# Mail
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@timeclocker.app"
MAIL_FROM_NAME="Timeclocker"
MAIL_REPLY_TO_ADDRESS="hello@timeclocker.app"
MAIL_REPLY_TO_NAME="Timeclocker"

# Filesystems
FILESYSTEM_DISK=s3
PUBLIC_FILESYSTEM_DISK=s3
S3_ACCESS_KEY_ID=sail
S3_SECRET_ACCESS_KEY=password
S3_REGION=us-east-1
S3_BUCKET=local
S3_URL=http://storage.timeclocker.test/local
S3_ENDPOINT=http://storage.timeclocker.test
S3_USE_PATH_STYLE_ENDPOINT=true

# Passport
PASSPORT_PERSONAL_ACCESS_CLIENT_ID="9e27f54d-5dfb-4dde-99d7-834518236c92"
PASSPORT_PERSONAL_ACCESS_CLIENT_SECRET="EL5mXp3aF8ITjcwoOXRpbSK7zGrWhW4zTDpQXTkf"

# Auditing
AUDITING_ENABLED=true

# Telescope
TELESCOPE_ENABLED=false

# Services
GOTENBERG_URL=http://gotenberg:3000

# Push Notifications (Web Push / VAPID)
# Generate VAPID keys using: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@timeclocker.app

# Local setup
NGINX_HOST_NAME=timeclocker.test
NETWORK_NAME=reverse-proxy-docker-traefik_routing
FORWARD_DB_PORT=54329
VITE_HOST_NAME=vite.timeclocker.test
VITE_APP_NAME="${APP_NAME}"
#SAIL_XDEBUG_MODE=develop,debug,coverage
