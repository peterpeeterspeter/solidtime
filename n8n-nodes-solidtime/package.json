{
  "name": "n8n-nodes-solidtime",
  "version": "1.0.0",
  "description": "n8n nodes for Solidtime - Privacy-first time tracking and workflow automation",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "solidtime",
    "time tracking",
    "project management",
    "automation"
  ],
  "license": "MIT",
  "homepage": "https://github.com/solidtime-io/solidtime",
  "author": {
    "name": "Solidtime",
    "email": "hello@solidtime.io"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/solidtime-io/solidtime.git"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials package.json",
    "lintfix": "eslint nodes credentials package.json --fix",
    "prepublishOnly": "npm run build && npm run lint -c .eslintrc.prepublish.js nodes credentials package.json"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/SolidtimeApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Solidtime/Solidtime.node.js",
      "dist/nodes/SolidtimeTrigger/SolidtimeTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^18.16.0",
    "@typescript-eslint/parser": "^5.59.0",
    "eslint": "^8.40.0",
    "eslint-plugin-n8n-nodes-base": "^1.11.0",
    "gulp": "^4.0.2",
    "n8n-workflow": "^1.0.0",
    "prettier": "^2.8.8",
    "typescript": "^5.0.4"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
