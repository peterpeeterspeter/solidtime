# Supabase Edge Functions Environment Variables
# These should be set as Supabase secrets in production
# Use: supabase secrets set KEY=value

# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Internal Security Token
# Must match the token in frontend/.env
INTERNAL_FUNCTION_TOKEN=your-secure-random-token-here

# LLM API Keys (configure only the ones you need)

# OpenAI (for GPT models)
OPENAI_API_KEY=sk-your-openai-key-here

# Anthropic (for Claude models) - Optional
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Google (for Gemini models) - Optional
GOOGLE_API_KEY=your-google-api-key-here

# Notes:
# - Never commit actual keys to git
# - In production, set these using: supabase secrets set KEY=value
# - For local development with Supabase CLI, create .env file in functions directory
# - You can verify secrets with: supabase secrets list
